{
  "_comment": [
    "`jobs` is the Nix lane's matrix: one entry per parallel job, and a job",
    "with more than one shard becomes that many jobs. Group suites that",
    "finish in seconds -- their cost is job setup, not testing -- and shard",
    "the ones that do not, so the stage costs what its slowest shard costs.",
    "`native` is the second lane: the platforms Nix cannot reach, which is",
    "where upstream gates. `suites` is how each component's suite is invoked.",
    "`forked` is on for every suite because upstream's test.py passes --forked to all of them, not just angr; running a suite in shared workers when upstream runs it one process per test is a different test."
  ],
  "jobs": [
    {
      "label": "components",
      "suites": [
        "archinfo",
        "pyvex",
        "pypcode",
        "claripy",
        "cle",
        "pysoot",
        "tracer",
        "angr-platforms"
      ]
    },
    {
      "label": "angr-management",
      "suites": [
        "angr-management"
      ],
      "shards": 3
    },
    {
      "label": "angr",
      "suites": [
        "angr"
      ],
      "shards": 10
    },
    {
      "label": "angrop",
      "suites": [
        "angrop"
      ]
    }
  ],
  "suites": {
    "archinfo": {
      "env": "test",
      "forked": true
    },
    "pyvex": {
      "env": "test",
      "forked": true
    },
    "pypcode": {
      "env": "test",
      "forked": true
    },
    "claripy": {
      "env": "test",
      "forked": true
    },
    "cle": {
      "env": "test",
      "forked": true
    },
    "angr": {
      "env": "test",
      "forked": true,
      "excluded": {
        "tests/exploration_techniques/test_tracer.py::TestTracer::test_cgc_random_syscall_handling_native_interface": "angr's CGC random-syscall emulation desyncs from the trace that shellphish-qemu 0.12.4's cgc-tracer produces (TracerDesyncError). Deterministic, and unrelated to packaging: the qemu binary runs and unicorn is 2.1.4 as angr pins it. The other 24 tracer tests pass."
      }
    },
    "angr-management": {
      "env": "gui",
      "qt": true,
      "forked": false,
      "module": "angrmanagement"
    },
    "pysoot": {
      "env": "test",
      "forked": true
    },
    "tracer": {
      "env": "test",
      "forked": true
    },
    "angr-platforms": {
      "env": "test",
      "forked": true,
      "fixtures": [
        "test_programs"
      ],
      "module": "angr_platforms"
    },
    "angrop": {
      "env": "test",
      "forked": true
    }
  },
